---
/**
 * Header — fixed top bar: wordmark, section anchors (desktop), language toggle.
 */
import { profile, ui, slideOrder } from '../data/content';
import { lessonOrder } from '../data/lessons';

interface Props {
  lang: 'zh' | 'en';
  /** Lang-toggle target for non-deck pages (e.g. the same lesson in the other language). */
  toggleHref?: string;
  /** Pre-lit nav entry on off-deck pages (e.g. 'publications' on the pubs page). */
  activeNav?: string;
}

const { lang, toggleHref, activeNav } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];
const base = (import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL).replace(/\/$/, '');
const otherLangHref = toggleHref ?? (lang === 'zh' ? `${base}/en/` : `${base}/`);
/* On the deck the toggle preserves the current slide via the hash; on a lesson page it just swaps routes. */
const toggleAttrs = toggleHref ? {} : { onclick: 'this.href += location.hash' };

/* One nav entry for all lessons (label 課程/Lesson, links to the first
   lesson slide). It glows while any lesson slide is active — the deck
   script matches via data-nav-group. Join stays the bordered CTA. */
const isLesson = (id: string) => (lessonOrder as readonly string[]).includes(id);
const navItems: { href: string; label: string; navId?: string; group?: string; cta?: boolean }[] = [];
for (const id of slideOrder.slice(1)) {
  if (isLesson(id)) {
    if (!navItems.some((n) => n.group)) {
      navItems.push({
        href: `${base}/#${lessonOrder[0]}`,
        label: t(ui.lessonNav),
        group: (lessonOrder as readonly string[]).join(','),
      });
    }
  } else if (id === 'join') {
    // The full publication list lives off-deck; its nav entry is a page link.
    navItems.push({
      href: `${lang === 'zh' ? base : `${base}/en`}/publications/`,
      label: t(ui.nav.publications),
      navId: 'publications',
    });
    navItems.push({ href: `${base}/`, label: t(ui.nav.join), navId: id, cta: true });
  } else {
    navItems.push({ href: `${base}/#${id}`, label: t(ui.nav[id as keyof typeof ui.nav]), navId: id });
  }
}
---

<header class="site-header no-print">
  <a class="wordmark" href={`${base}/#${slideOrder[0]}`}>
    ISB<span> Lab</span>
  </a>

  <nav class="site-nav d-none d-lg-flex gap-3 gap-xl-4" aria-label={lang === 'zh' ? '區塊導覽' : 'Sections'}>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class={item.cta ? 'nav-cta' : ''}
          data-nav={item.navId}
          data-nav-group={item.group}
          aria-current={item.navId && item.navId === activeNav ? 'true' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="lang-toggle" href={otherLangHref} hreflang={lang === 'zh' ? 'en' : 'zh'} {...toggleAttrs}>
    {t(ui.langToggle)}
  </a>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.9rem var(--gutter);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: var(--hairline);
  }

  .wordmark {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--sky-deep);
  }

  .wordmark span {
    font-weight: 300;
  }

  .site-nav a {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gray-1);
    padding: 0.25em 0;
    border-bottom: 1px solid transparent;
    transition:
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      text-shadow 0.25s var(--ease-out);
  }

  .site-nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* Current slide: its nav entry lights up with a sky glow.
     Set by the deck script in Home.astro (aria-current). Cover shows none. */
  .site-nav a[aria-current='true'] {
    color: var(--sky-deep);
    border-bottom-color: var(--sky);
    text-shadow: 0 0 14px rgba(25, 113, 194, 0.55);
  }

  .site-nav a.nav-cta {
    color: var(--sky-deep);
    border: 1px solid var(--sky);
    padding: 0.5em 1em;
  }

  .site-nav a.nav-cta:hover,
  .site-nav a.nav-cta[aria-current='true'] {
    background: var(--sky);
    border-color: var(--sky);
    color: var(--paper);
    text-shadow: none;
  }

  .lang-toggle {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    border: 1px solid var(--sky);
    color: var(--sky);
    padding: 0.45em 0.9em;
    white-space: nowrap;
  }

  .lang-toggle:hover {
    background: var(--sky-deep);
    border-color: var(--sky-deep);
    color: var(--paper);
  }
</style>
