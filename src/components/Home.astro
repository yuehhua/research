---
/**
 * Home — the entire slide deck, rendered per language by thin page wrappers.
 * Layout: Bootstrap 5 grid & utilities. Brand: our tokens (sky/leaf) in global.css.
 * All copy comes from src/data/content.ts.
 */
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Slide from '../layouts/Slide.astro';
import Header from './Header.astro';
import NavDots from './NavDots.astro';
import portrait from '../assets/portrait.jpg';
import leafImg from '../assets/leaf.png';
import {
  ui,
  profile,
  hero,
  about,
  interests,
  focusChips,
  projects,
  publications,
  tmuCourses,
  join,
  footer,
} from '../data/content';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];

const eyebrow: Record<string, { zh: string; en: string }> = {
  hero: { zh: 'ISB LAB', en: 'ISB LAB' },
  about: ui.nav.about,
  research: ui.nav.research,
  projects: ui.nav.projects,
  publications: ui.nav.publications,
  teaching: ui.nav.teaching,
  join: ui.nav.join,
};

const pageTitle =
  lang === 'zh'
    ? 'ISB Lab 智慧系統生物實驗室 · 臺北醫學大學'
    : 'ISB Lab — Intelligent Systems Biology Lab · Taipei Medical University';
const pageDesc =
  lang === 'zh'
    ? '臺北醫學大學智慧系統生物實驗室：計算生物學 × 機器學習，從基因調控網路到虛擬細胞。杜岳華助理教授主持。'
    : 'Intelligent Systems Biology Lab at Taipei Medical University: computational biology × machine learning, from gene regulatory networks to virtual cells. Led by Assistant Professor Yueh-Hua Tu.';
const base = (import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL).replace(/\/$/, '');
const otherLangUrl = lang === 'zh' ? `${base}/en/` : `${base}/`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={`${base}/`} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh'} href={otherLangUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230B57A4'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='800' font-size='14' fill='%23fff' text-anchor='middle'%3EI%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body>
    <Header lang={lang} />
    <NavDots lang={lang} />

    <p class="scroll-hint no-print" data-hint aria-hidden="true">{t(ui.scrollHint)}</p>

    <main>
      {/* ---------------------------------------------- 01 HERO */}
      <Slide id="hero" num="01" label={t(eyebrow.hero)}>
        <div class="nature" aria-hidden="true">
          <Image class="leaf-photo" src={leafImg} alt="" widths={[480, 720, 960]} sizes="(max-width: 640px) 200px, 34vw" loading="lazy" />
        </div>

        <p class="hero-kicker">{profile.labName}</p>
        <h1 class="hero-title">{lang === 'zh' ? profile.labNameZh : profile.labName}</h1>
        <p class="hero-tagline">{t(hero.tagline)}</p>
        <p class="hero-sub muted">{t(hero.sub)}</p>

        <p class="hero-byline d-flex flex-wrap gap-1 gap-md-3 border-top pt-3 mb-4">
          <span><strong>{t(profile.name)}, {profile.degree}</strong> · {t(profile.title)}</span>
          <span class="hero-affil muted">{t(profile.affiliation)}</span>
        </p>

        <div class="hero-actions mb-4">
          <a class="chip" href={hero.challengeUrl} target="_blank" rel="noopener">
            <span class="pulse" aria-hidden="true"></span>
            {t(hero.challengeBadge)} ↗
          </a>
        </div>

        <div class="d-flex flex-wrap gap-3">
          <a class="btn btn-sky btn-deck" href={`${base}/#join`}>{t(hero.cta.join)}</a>
          <a class="btn btn-outline-sky btn-deck" href={`${base}/#research`}>{t(hero.cta.research)}</a>
        </div>
      </Slide>

      {/* ---------------------------------------------- 02 ABOUT */}
      <Slide id="about" num="02" label={t(eyebrow.about)}>
        <h2 class="slide__title">{t(profile.name)} · {t(profile.title)}</h2>
        <div class="row g-4 g-lg-5 about-grid">
          <figure class="portrait col-12 col-md-4 col-lg-3">
            <Image src={portrait} alt={lang === 'zh' ? '杜岳華' : 'Yueh-Hua Tu'} widths={[360, 540, 720]} sizes="(max-width: 767px) 92vw, (max-width: 991px) 33vw, 300px" />
          </figure>
          <div class="bio col-12 col-md-8 col-lg-9">
            {about.bio.map((p) => <p>{t(p)}</p>)}
          </div>
        </div>
      </Slide>

      {/* ---------------------------------------------- 03 RESEARCH */}
      <Slide id="research" num="03" label={t(eyebrow.research)}>
        <h2 class="slide__title">{t(ui.nav.research)}</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-1 interest-grid mb-4 mb-lg-5">
          {
            interests.map((it, i) => (
              <article class="interest border bg-white p-3 p-lg-4">
                <span class="interest-idx">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="interest-name h6 mt-2 mb-2">{t(it.name)}</h3>
                <p class="interest-desc muted small mb-0">{t(it.desc)}</p>
              </article>
            ))
          }
        </div>
        <div class="focus d-flex flex-wrap align-items-center gap-2 gap-md-4 border-top pt-3">
          <span class="label">{t(ui.currentFocus)}</span>
          <ul class="focus-chips d-flex flex-wrap gap-2 mb-0 ps-0">
            {focusChips.map((c) => <li>{t(c)}</li>)}
            <li>
              <a href={hero.challengeUrl} target="_blank" rel="noopener">NeurIPS 2026 Virtual Embryo ↗</a>
            </li>
          </ul>
        </div>
      </Slide>

      {/* ---------------------------------------------- 04 PROJECTS */}
      <Slide id="projects" num="04" label={t(eyebrow.projects)}>
        <h2 class="slide__title">{t(ui.nav.projects)}</h2>
        <div class="projects">
          {
            projects.map((p) => (
              <article class="project row g-3 g-lg-4 py-2 py-lg-3">
                <div class="project-head col-12 col-lg-3">
                  <h3 class="project-name h5 mt-1 mb-1">{p.name}</h3>
                  <p class="project-tag label mb-0">{t(p.tag)}</p>
                </div>
                <p class="project-desc muted small col-12 col-lg-6 mb-0">{t(p.desc)}</p>
                <div class="project-side col-12 col-lg-3">
                  <div class="project-metrics d-flex flex-wrap gap-3 gap-lg-4">
                    {p.metrics.map((m) => (
                      <div class="metric">
                        <span class="value">{m.value}</span>
                        <span class="key">{t(m.label)}</span>
                      </div>
                    ))}
                  </div>
                  {p.links && (
                    <p class="project-links d-flex flex-wrap gap-2 small fw-bold mb-0 mt-2">
                      {p.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </Slide>

      {/* ---------------------------------------------- 05 PUBLICATIONS */}
      <Slide id="publications" num="05" label={t(eyebrow.publications)}>
        <h2 class="slide__title">{t(ui.nav.publications)}</h2>
        <ol class="pubs list-unstyled mb-0" data-inner-scroll>
          {
            publications.map((pub) => (
              <li class="pub">
                <span class="pub-year">{pub.year}</span>
                <div class="pub-main">
                  <p class="pub-title mb-1">
                    {pub.title}
                    {pub.firstAuthor && <span class="pub-badge">{t(ui.firstAuthor)}</span>}
                  </p>
                  <p class="pub-authors muted small mb-1">
                    <span class={pub.firstAuthor ? 'is-first' : ''}>{pub.authors.split(',')[0]}</span>{pub.authors.substring(pub.authors.split(',')[0].length)}
                  </p>
                  <p class="pub-venue small fst-italic mb-0">{pub.venue}</p>
                </div>
                <a class="pub-link" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" aria-label={`${t(ui.viewPaper)}: ${pub.title}`}>↗</a>
              </li>
            ))
          }
        </ol>
      </Slide>

      {/* ---------------------------------------------- 06 TEACHING */}
      <Slide id="teaching" num="06" label={t(eyebrow.teaching)}>
        <h2 class="slide__title">{t(ui.nav.teaching)}</h2>
        <div class="row row-cols-1 row-cols-md-2 g-1 course-grid">
          {
            tmuCourses.map((c) => (
              <article class="course border bg-white p-3 p-lg-4">
                <h3 class="course-name h6 mt-0 mb-0">{t(c.name)}</h3>
                <p class="course-desc muted small mt-2 mb-0">{t(c.desc)}</p>
              </article>
            ))
          }
        </div>
      </Slide>

      {/* ---------------------------------------------- 07 JOIN US */}
      <Slide id="join" num="07" label={t(eyebrow.join)}>
        <h2 class="slide__title">{t(join.heading)}</h2>
        <p class="join-intro muted">{t(join.intro)}</p>
        <div class="row g-4 mb-4 mb-lg-5">
          <section class="join-col col-12 col-md-6">
            <h3 class="label mb-3">{t(join.youAre)}</h3>
            <ul class="join-list mb-0 ps-0">
              {join.youAreItems.map((item) => <li>{t(item)}</li>)}
            </ul>
          </section>
          <section class="join-col col-12 col-md-6">
            <h3 class="label mb-3">{t(join.weOffer)}</h3>
            <ul class="join-list mb-0 ps-0">
              {join.weOfferItems.map((item) => <li>{t(item)}</li>)}
            </ul>
          </section>
        </div>
        <div class="join-cta border-top pt-4">
          <p class="small mb-0">
            <span class="muted">{t(join.ctaPre)}</span><a class="fw-bold" href={`mailto:${profile.email}?subject=${encodeURIComponent('專題生')}`}>{profile.email}</a><span class="muted">{t(join.ctaPost)}</span>
          </p>
        </div>

        {/* Footer anchored to the bottom of the last slide — visible without an extra scroll */}
        <footer class="site-footer">
          <div class="footer-inner row row-cols-1 row-cols-md-3 g-2 g-md-3 mx-0 align-items-baseline">
            <p class="footer-id col-12 col-md-4 mb-0">
              <strong>{profile.labShort} · {profile.labName}</strong><br />
              <span class="muted">{t(footer.address)}</span>
            </p>
            <ul class="footer-links col-12 col-md d-flex flex-wrap justify-content-md-center gap-2 gap-md-3 list-unstyled mb-0">
              <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
              {profile.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
            </ul>
            <p class="footer-copy col-12 col-md-auto ms-md-auto mb-0">{t(footer.copyright)}</p>
          </div>
        </footer>
      </Slide>
    </main>

    <script>
      // Deck behavior: active-slide tracking, dots, keyboard navigation.
      const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
      const dots = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-dot]'));
      const hint = document.querySelector<HTMLElement>('[data-hint]');

      let idx = 0;

      function render(): void {
        dots.forEach((d, i) => {
          if (i === idx) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
        hint?.classList.toggle('is-visible', idx === 0);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              idx = slides.indexOf(e.target as HTMLElement);
              render();
            }
          }
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      slides.forEach((s) => io.observe(s));
      render();

      function go(i: number): void {
        const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
        target?.scrollIntoView({ behavior: 'smooth' });
      }

      // Let an inner scrollable list (e.g. publications) finish scrolling first.
      function innerCanScroll(dir: number): boolean {
        const el = document.activeElement;
        if (!el || el === document.body) return false;
        const scroller = (el as HTMLElement).closest('[data-inner-scroll]');
        if (!scroller) return false;
        return dir > 0
          ? scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1
          : scroller.scrollTop > 1;
      }

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        const next = ['ArrowDown', 'ArrowRight', 'PageDown', ' '];
        const prev = ['ArrowUp', 'ArrowLeft', 'PageUp'];
        if (next.includes(e.key)) {
          if (innerCanScroll(1)) return;
          e.preventDefault();
          go(idx + 1);
        } else if (prev.includes(e.key)) {
          if (innerCanScroll(-1)) return;
          e.preventDefault();
          go(idx - 1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          go(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          go(slides.length - 1);
        }
      });
    </script>
  </body>
</html>

<style>
  /* ---------- Scroll hint (right side, cover slide only) ---------- */
  .scroll-hint {
    position: fixed;
    right: var(--gutter);
    bottom: 1.25rem;
    z-index: 90;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gray-2);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .scroll-hint.is-visible {
    opacity: 1;
    animation: nudge 2.2s var(--ease-out) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 3px;
    }
  }

  /* Clear of the mobile dot rail */
  @media (max-width: 767px) {
    .scroll-hint {
      display: none;
    }
  }

  /* ---------- Hero: sky gradient + leaf photo ---------- */

  .nature {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* CC0 leaf photo (rawpixel via Openverse), white bg → alpha */
  .leaf-photo {
    position: absolute;
    right: max(1.5rem, calc(var(--gutter) * 0.5));
    bottom: clamp(0.5rem, 5vh, 3rem);
    width: clamp(230px, 30vw, 460px);
    rotate: -10deg;
    opacity: 0.96;
  }

  @media (max-width: 640px) {
    .leaf-photo {
      width: 190px;
      opacity: 0.85;
    }
  }

  .hero-kicker,
  .hero-title,
  .hero-tagline,
  .hero-sub,
  .hero-byline,
  .hero-actions,
  .hero-ctas,
  .d-flex {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    max-width: 14ch;
    color: var(--sky-deep);
  }

  .hero-tagline {
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .hero-sub {
    max-width: 46ch;
    margin-bottom: 2rem;
  }

  .hero-byline {
    font-size: var(--text-small);
    max-width: 62ch;
  }

  .hero-affil {
    flex-basis: 100%;
  }

  /* ---------- About ---------- */
  .about-grid > * {
    min-width: 0;
  }

  .portrait img {
    width: 100%;
    border: var(--hairline);
  }

  .bio p + p {
    margin-top: 0.9em;
  }

  /* ---------- Research ---------- */
  .interest-idx {
    font-size: var(--text-label);
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--sky);
  }

  .interest-name {
    color: var(--sky-deep);
    font-weight: 800;
  }

  .interest-desc {
    max-width: 42ch;
  }

  .focus-chips {
    list-style: none;
  }

  .focus-chips li {
    background: var(--sky-wash);
    padding: 0.45em 0.85em;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--sky-deep);
  }

  .focus-chips li:has(a) {
    background: var(--paper);
    border: 1px solid var(--leaf);
    color: var(--leaf-deep);
  }

  .focus-chips a {
    text-decoration: none;
    color: inherit;
  }

  .focus-chips a:hover {
    background: var(--leaf);
    color: var(--paper);
  }

  /* ---------- Projects ---------- */
  .project-name {
    color: var(--sky-deep);
    font-weight: 800;
  }

  .project-desc {
    max-width: 68ch;
  }

  @media (min-width: 992px) {
    .project-side {
      border-left: var(--hairline-soft);
      padding-left: 1.5rem;
    }
  }

  /* ---------- Publications ---------- */
  .pubs {
    max-height: min(58svh, 34rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .pub {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 0.25rem 1.5rem;
    border-top: var(--hairline-soft);
    padding: 0.75em 0;
    align-items: start;
  }

  .pub:first-child {
    border-top: none;
  }

  .pub-year {
    font-weight: 800;
    color: var(--sky-deep);
    font-variant-numeric: tabular-nums;
  }

  .pub-title {
    font-weight: 700;
    line-height: 1.35;
    max-width: 60ch;
    color: var(--sky-deep);
  }

  .pub-badge {
    display: inline-block;
    border: 1px solid var(--leaf);
    color: var(--leaf-deep);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.1em 0.55em;
    margin-left: 0.6em;
    vertical-align: middle;
    white-space: nowrap;
  }

  .pub-authors .is-first {
    font-weight: 800;
  }

  .pub-link {
    font-size: 1.1rem;
    text-decoration: none;
    padding: 0.2em;
  }

  .pub-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pub {
      grid-template-columns: 1fr auto;
    }

    .pub-year {
      grid-column: 1 / -1;
      font-size: var(--text-small);
    }
  }

  /* ---------- Teaching ---------- */
  .course-name {
    color: var(--sky-deep);
    font-weight: 800;
  }

  .course-desc {
    max-width: 52ch;
  }

  /* ---------- Join ---------- */
  .join-intro {
    font-size: var(--text-subtitle);
    font-weight: 500;
    max-width: 40ch;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .join-list {
    list-style: none;
  }

  .join-list li {
    border-top: var(--hairline-soft);
    padding: 0.7em 0;
    font-size: var(--text-small);
  }

  .join-list li:first-child {
    border-top: none;
  }

  /* ---------- Footer: deep sky band at the bottom of the last slide ---------- */
  .site-footer {
    background: var(--sky-deep);
    color: #d9ebfc;
    /* Full-bleed: escape the slide's horizontal padding; margin-top:auto pins it to the slide bottom */
    margin: auto calc(var(--gutter) * -1) 0;
    padding: 1.5rem var(--gutter) 1.25rem;
  }

  .footer-inner {
    font-size: var(--text-small);
  }

  .footer-inner strong {
    color: var(--paper);
  }

  .footer-inner .muted {
    color: #9cc3ee;
  }

  .footer-links a {
    color: var(--paper);
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .footer-links a:hover {
    text-decoration-color: var(--paper);
  }
</style>

<style is:global>
  /* Slide-level backgrounds & padding overrides.
     These target <section> roots rendered by Slide.astro, which does NOT carry
     this component's data-astro-cid scope — so they must be global to match.
     Background rhythm: cover = sky gradient, then light-blue / light-green /
     white alternate so no two adjacent slides share a background. */
  #hero {
    background:
      radial-gradient(52rem 30rem at 108% -12%, rgba(116, 192, 252, 0.28), transparent 60%),
      radial-gradient(40rem 26rem at -14% 112%, rgba(116, 192, 252, 0.2), transparent 62%),
      linear-gradient(178deg, var(--sky-wash) 0%, var(--paper) 58%);
  }

  #about,
  #publications {
    background:
      radial-gradient(46rem 26rem at 110% 0%, rgba(116, 192, 252, 0.1), transparent 60%),
      var(--sky-wash);
  }

  #research {
    background:
      radial-gradient(46rem 26rem at -10% 100%, rgba(64, 160, 43, 0.08), transparent 60%),
      var(--leaf-wash);
  }

  #teaching {
    background:
      radial-gradient(46rem 26rem at 110% 0%, rgba(64, 160, 43, 0.08), transparent 60%),
      var(--leaf-wash);
  }

  #join {
    /* The footer lives inside this slide, anchored to its bottom edge */
    padding-bottom: 0;
  }
</style>
