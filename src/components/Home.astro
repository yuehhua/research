---
/**
 * Home — the entire slide deck, rendered per language by thin page wrappers.
 * Layout: Bootstrap 5 grid & utilities. Brand: our tokens (sky/leaf) in global.css.
 * All copy comes from src/data/content.ts.
 */
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Slide from '../layouts/Slide.astro';
import Header from './Header.astro';
import portrait from '../assets/portrait.jpg';
import leafImg from '../assets/leaf.svg';
import dmBg from '../assets/discrete_math_Gemini.png';
import dsaBg from '../assets/data_structure_algo_Gemini.png';
import bioBg from '../assets/bioinfo_Gemini.png';
import {
  ui,
  profile,
  hero,
  about,
  join,
  footer,
} from '../data/content';
import {
  lessonUi,
  discreteMath,
  dataStructuresAlgorithms,
  bioinformatics,
  smartHealthcareBigData,
  type Lesson,
} from '../data/lessons';
import { researchThemes, themeImages, visuals } from '../data/research';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];

/* One deck slide per lesson: user-designed background where available,
   goal + module map, link to the full lesson page when it exists. */
const lessonSlides: { lesson: Lesson; bg: ImageMetadata | null; linked: boolean }[] = [
  { lesson: discreteMath, bg: dmBg, linked: true },
  { lesson: dataStructuresAlgorithms, bg: dsaBg, linked: true },
  { lesson: bioinformatics, bg: bioBg, linked: true },
  { lesson: smartHealthcareBigData, bg: null, linked: false },
];

const eyebrow: Record<string, { zh: string; en: string }> = {
  hero: { zh: 'ISB LAB', en: 'ISB LAB' },
  about: ui.nav.about,
  research: ui.nav.research,
  join: ui.nav.join,
};

const pageTitle =
  lang === 'zh'
    ? 'ISB Lab 智慧系統生物實驗室 · 臺北醫學大學'
    : 'ISB Lab — Intelligent Systems Biology Lab · Taipei Medical University';
const pageDesc =
  lang === 'zh'
    ? '臺北醫學大學智慧系統生物實驗室：計算生物學 × 機器學習，從基因調控網路到虛擬細胞。杜岳華助理教授主持。'
    : 'Intelligent Systems Biology Lab at Taipei Medical University: computational biology × machine learning, from gene regulatory networks to virtual cells. Led by Assistant Professor Yueh-Hua Tu.';
const base = (import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL).replace(/\/$/, '');
const otherLangUrl = lang === 'zh' ? `${base}/en/` : `${base}/`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={`${base}/`} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh'} href={otherLangUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230B57A4'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='800' font-size='14' fill='%23fff' text-anchor='middle'%3EI%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body>
    <Header lang={lang} />

    <p class="scroll-hint no-print" data-hint aria-hidden="true">{t(ui.scrollHint)}</p>

    <main>
      {/* ---------------------------------------------- 01 HERO */}
      <Slide id="hero" num="01" label={t(eyebrow.hero)}>
        <div class="nature" aria-hidden="true">
          <Image class="leaf-photo" src={leafImg} alt="" loading="lazy" />
        </div>

        <p class="hero-kicker">{profile.labName}</p>
        <h1 class="hero-title">{lang === 'zh' ? profile.labNameZh : profile.labName}</h1>
        <p class="hero-tagline">{t(hero.tagline)}</p>
        <p class="hero-sub muted">{t(hero.sub)}</p>

        <p class="hero-byline d-flex flex-wrap gap-1 gap-md-3 border-top pt-3 mb-4">
          <span><strong>{t(profile.name)}, {profile.degree}</strong> · {t(profile.title)}</span>
          <span class="hero-affil muted">{t(profile.affiliation)}</span>
        </p>

        <div class="hero-actions mb-4">
          <a class="chip" href={hero.challengeUrl} target="_blank" rel="noopener">
            <span class="pulse" aria-hidden="true"></span>
            {t(hero.challengeBadge)} ↗
          </a>
        </div>

        <div class="d-flex flex-wrap gap-3">
          <a class="btn btn-sky btn-deck" href={`${base}/#join`}>{t(hero.cta.join)}</a>
          <a class="btn btn-outline-sky btn-deck" href={`${base}/#${researchThemes[0].slug}`}>{t(hero.cta.research)}</a>
        </div>
      </Slide>

      {/* ---------------------------------------------- 02 ABOUT */}
      <Slide id="about" num="02" label={t(eyebrow.about)}>
        <h2 class="slide__title">{t(profile.name)} · {t(profile.title)}</h2>
        <div class="row g-4 g-lg-5 about-grid">
          <figure class="portrait col-12 col-md-4 col-lg-3">
            <Image src={portrait} alt={lang === 'zh' ? '杜岳華' : 'Yueh-Hua Tu'} widths={[360, 540, 720]} sizes="(max-width: 767px) 92vw, (max-width: 991px) 33vw, 300px" />
          </figure>
          <div class="bio col-12 col-md-8 col-lg-9">
            {about.bio.map((p) => <p>{t(p)}</p>)}
          </div>
        </div>
      </Slide>

      {/* ---------------------------------------------- 03–06 RESEARCH (one slide per theme) */}
      {
        researchThemes.map((theme, i) => (
          <Slide id={theme.slug} num={String(i + 3).padStart(2, '0')} label={t(eyebrow.research)}>
            <div class="row g-4 g-lg-5 align-items-center research-slide-body">
              <div class="research-slide-text col-12 col-lg-7">
                <h2 class="slide__title research-slide-title">{t(theme.name)}</h2>
                <p class="research-slide-short muted">{t(theme.short)}</p>
                <ul class="research-tags d-flex flex-wrap gap-2 ps-0 mb-0">
                  {theme.tags.map((tag) => (
                    <li>{t(tag)}</li>
                  ))}
                </ul>
                <div class="mt-4">
                  {theme.externalCta && (
                    <a class="btn btn-outline-sky btn-deck" href={theme.externalCta.href} target="_blank" rel="noopener">
                      {t(theme.externalCta.label)} ↗
                    </a>
                  )}
                </div>
                {theme.links.length > 0 && (
                  <p class="research-slide-links d-flex flex-wrap gap-3 small fw-bold mt-3 mb-0">
                    {theme.links.map((l) => (
                      <a class="research-slide-link" href={l.href} target="_blank" rel="noopener">
                        {l.label} ↗
                      </a>
                    ))}
                  </p>
                )}
              </div>
              <div class="col-12 col-lg-5">
                <div class="research-figure">
                  <Image
                    class="research-figure-img"
                    src={themeImages[theme.slug]}
                    alt={t(visuals[theme.slug].alt)}
                    loading="lazy"
                    widths={[360, 540, 760]}
                    sizes="(max-width: 991px) 90vw, 460px"
                  />
                </div>
              </div>
            </div>
          </Slide>
        ))
      }

      {/* ---------------------------------------------- 07–10 LESSONS (one slide per course) */}
      {
        lessonSlides.map(({ lesson, bg, linked }, i) => (
          <Slide id={lesson.slug} num={String(i + 7).padStart(2, '0')} label={t(ui.lessonNav)}>
            {bg && (
              <div class="lesson-nature" aria-hidden="true">
                <Image class="lesson-bg-img" src={bg} alt="" loading="lazy" widths={[640, 1024, 1376]} sizes="100vw" />
              </div>
            )}
            <div class="lesson-slide-body">
              <h2 class="slide__title lesson-slide-title">{t(lesson.name)}</h2>
              <p class="lesson-slide-goal muted">{t(lesson.goal)}</p>
              <ul class="lesson-chips d-flex flex-wrap gap-2 ps-0 mb-0">
                {lesson.modules.map((m) => (
                  <li>
                    <span class="chip-num">{m.num}</span> {t(m.name)}
                  </li>
                ))}
              </ul>
              {linked && (
                <a class="btn btn-outline-sky btn-deck mt-4" href={`${base}/lessons/${lesson.slug}/`}>
                  {t(lessonUi.viewCourse)} ↗
                </a>
              )}
            </div>
          </Slide>
        ))
      }

      {/* ---------------------------------------------- 11 JOIN US */}
      <Slide id="join" num="11" label={t(eyebrow.join)}>
        <div class="join-content">
          <h2 class="slide__title">{t(join.heading)}</h2>
          <p class="join-slogan">{t(join.slogan)}</p>
          <p class="join-intro muted">{t(join.intro)}</p>
          <div class="row g-4 mb-4 mb-lg-5">
            <section class="join-col col-12 col-md-6">
              <h3 class="label mb-3">{t(join.youAre)}</h3>
              <ul class="join-list mb-0 ps-0">
                {join.youAreItems.map((item) => <li>{t(item)}</li>)}
              </ul>
            </section>
            <section class="join-col col-12 col-md-6">
              <h3 class="label mb-3">{t(join.weOffer)}</h3>
              <ul class="join-list mb-0 ps-0">
                {join.weOfferItems.map((item) => <li>{t(item)}</li>)}
              </ul>
            </section>
          </div>
          <div class="join-cta border-top pt-4">
            <p class="small mb-0">
              <span class="muted">{t(join.ctaPre)}</span><a class="fw-bold" href={`mailto:${profile.email}?subject=${encodeURIComponent('專題生')}`}>{profile.email}</a><span class="muted">{t(join.ctaPost)}</span>
            </p>
          </div>
        </div>

        {/* Footer anchored to the bottom of the last slide — visible without an extra scroll */}
        <footer class="site-footer">
          <div class="footer-inner row row-cols-1 row-cols-md-3 g-2 g-md-3 mx-0 align-items-baseline">
            <p class="footer-id col-12 col-md-4 mb-0">
              <strong>{profile.labShort} · {profile.labName}</strong><br />
              <span class="muted">{t(footer.address)}</span>
            </p>
            <ul class="footer-links col-12 col-md d-flex flex-wrap justify-content-md-center gap-2 gap-md-3 list-unstyled mb-0">
              <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
              {profile.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
            </ul>
            <p class="footer-copy col-12 col-md-auto ms-md-auto mb-0">{t(footer.copyright)}</p>
          </div>
        </footer>
      </Slide>
    </main>

    <script>
      // Deck behavior: active-slide tracking (header nav glow), keyboard navigation.
      const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
      // .site-nav a covers both single entries ([data-nav]) and the grouped Lesson entry ([data-nav-group])
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-nav a'));
      const hint = document.querySelector<HTMLElement>('[data-hint]');

      let idx = 0;

      function render(): void {
        const current = slides[idx]?.id;
        navLinks.forEach((a) => {
          // The single Lesson entry matches any lesson slide via data-nav-group;
          // other entries match their own slide. Cover (hero) highlights none.
          const group = a.dataset.navGroup?.split(',');
          const on = group ? group.includes(current) : a.dataset.nav === current;
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
        hint?.classList.toggle('is-visible', idx === 0);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              idx = slides.indexOf(e.target as HTMLElement);
              render();
            }
          }
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      slides.forEach((s) => io.observe(s));
      render();

      function go(i: number): void {
        const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
        target?.scrollIntoView({ behavior: 'smooth' });
      }

      // Let an inner scrollable list (e.g. publications) finish scrolling first.
      function innerCanScroll(dir: number): boolean {
        const el = document.activeElement;
        if (!el || el === document.body) return false;
        const scroller = (el as HTMLElement).closest('[data-inner-scroll]');
        if (!scroller) return false;
        return dir > 0
          ? scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1
          : scroller.scrollTop > 1;
      }

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        const next = ['ArrowDown', 'ArrowRight', 'PageDown', ' '];
        const prev = ['ArrowUp', 'ArrowLeft', 'PageUp'];
        if (next.includes(e.key)) {
          if (innerCanScroll(1)) return;
          e.preventDefault();
          go(idx + 1);
        } else if (prev.includes(e.key)) {
          if (innerCanScroll(-1)) return;
          e.preventDefault();
          go(idx - 1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          go(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          go(slides.length - 1);
        }
      });
    </script>
  </body>
</html>

<style>
  /* ---------- Scroll hint (right side, cover slide only) ---------- */
  .scroll-hint {
    position: fixed;
    right: var(--gutter);
    bottom: 1.25rem;
    z-index: 90;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gray-2);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .scroll-hint.is-visible {
    opacity: 1;
    animation: nudge 2.2s var(--ease-out) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 3px;
    }
  }

  /* Scroll hint is desktop-only */
  @media (max-width: 767px) {
    .scroll-hint {
      display: none;
    }
  }

  /* ---------- Hero: sky gradient + leaf photo ---------- */

  .nature {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* CC0 leaf photo (rawpixel via Openverse), white bg → alpha */
  .leaf-photo {
    position: absolute;
    right: max(1.5rem, calc(var(--gutter) * 0.5));
    bottom: clamp(0.5rem, 5vh, 3rem);
    width: clamp(230px, 30vw, 460px);
    rotate: -10deg;
    opacity: 0.96;
  }

  @media (max-width: 640px) {
    .leaf-photo {
      width: 190px;
      opacity: 0.85;
    }
  }

  .hero-kicker,
  .hero-title,
  .hero-tagline,
  .hero-sub,
  .hero-byline,
  .hero-actions,
  .hero-ctas,
  .d-flex {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    max-width: 14ch;
    color: var(--sky-deep);
  }

  .hero-tagline {
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .hero-sub {
    max-width: 46ch;
    margin-bottom: 2rem;
  }

  .hero-byline {
    font-size: var(--text-small);
    max-width: 62ch;
  }

  .hero-affil {
    flex-basis: 100%;
  }

  /* ---------- About ---------- */
  .about-grid > * {
    min-width: 0;
  }

  .portrait img {
    width: 100%;
    border: var(--hairline);
  }

  .bio p + p {
    margin-top: 0.9em;
  }

  /* ---------- Research slides (one per theme) ---------- */
  .research-slide-title {
    max-width: 16ch;
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
  }

  .research-slide-short {
    font-size: var(--text-subtitle);
    font-weight: 500;
    max-width: 40ch;
    margin-bottom: clamp(1rem, 2.5vh, 1.5rem);
  }

  .research-slide-link {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--sky-deep);
  }

  .research-tags {
    list-style: none;
  }

  .research-tags li {
    border: var(--hairline);
    background: rgba(255, 255, 255, 0.78);
    padding: 0.4em 0.85em;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--ink);
  }

  .research-figure {
    background: var(--paper);
    border: var(--hairline);
    padding: clamp(1rem, 2vw, 1.75rem);
    display: grid;
    place-items: center;
  }

  .research-figure-img {
    max-height: min(28rem, 46svh);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* ---------- Lesson slides (one per course) ---------- */
  .lesson-nature {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Left-heavy scrim: text column reads clean, the designed motifs stay visible right */
  .lesson-nature::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.85) 0%,
      rgba(255, 255, 255, 0.5) 45%,
      rgba(255, 255, 255, 0.12) 80%
    );
  }

  .lesson-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .lesson-slide-body {
    position: relative;
    z-index: 1;
    max-width: 60ch;
  }

  .lesson-slide-title {
    max-width: 16ch;
  }

  .lesson-slide-goal {
    max-width: 44ch;
    font-size: var(--text-subtitle);
    font-weight: 500;
    margin-bottom: clamp(1rem, 2.5vh, 1.75rem);
  }

  .lesson-chips {
    list-style: none;
  }

  .lesson-chips li {
    border: var(--hairline);
    background: rgba(255, 255, 255, 0.78);
    padding: 0.45em 0.9em;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--ink);
  }

  .lesson-chips .chip-num {
    font-weight: 800;
    color: var(--sky);
    margin-right: 0.15em;
  }

  /* ---------- Join ---------- */
  /* Content centers in the space ABOVE the footer, so the last page's visual
     balance matches the other slides despite the footer band. */
  .join-content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .join-slogan {
    font-size: var(--text-subtitle);
    font-weight: 700;
    color: var(--leaf-deep);
    margin-bottom: 0.6rem;
  }

  .join-intro {
    font-size: var(--text-subtitle);
    font-weight: 500;
    max-width: 40ch;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .join-list {
    list-style: none;
  }

  .join-list li {
    border-top: var(--hairline-soft);
    padding: 0.7em 0;
    font-size: var(--text-small);
  }

  .join-list li:first-child {
    border-top: none;
  }

  /* ---------- Footer: deep sky band at the bottom of the last slide ---------- */
  .site-footer {
    background: var(--sky-deep);
    color: #d9ebfc;
    /* Full-bleed: escape the slide's horizontal padding; margin-top:auto pins it to the slide bottom */
    margin: auto calc(var(--gutter) * -1) 0;
    padding: 1rem var(--gutter) 0.9rem;
  }

  .footer-inner {
    font-size: var(--text-small);
  }

  .footer-inner strong {
    color: var(--paper);
  }

  .footer-inner .muted {
    color: #9cc3ee;
  }

  .footer-links a {
    color: var(--paper);
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .footer-links a:hover {
    text-decoration-color: var(--paper);
  }
</style>

<style is:global>
  /* Slide-level backgrounds & padding overrides.
     These target <section> roots rendered by Slide.astro, which does NOT carry
     this component's data-astro-cid scope — so they must be global to match.
     Background rhythm: cover = sky gradient, then light-blue / light-green /
     white alternate so no two adjacent slides share a background. */
  #hero {
    background:
      radial-gradient(52rem 30rem at 108% -12%, rgba(116, 192, 252, 0.28), transparent 60%),
      radial-gradient(40rem 26rem at -14% 112%, rgba(116, 192, 252, 0.2), transparent 62%),
      linear-gradient(178deg, var(--sky-wash) 0%, var(--paper) 58%);
  }

  #about {
    background:
      radial-gradient(46rem 26rem at 110% 0%, rgba(116, 192, 252, 0.1), transparent 60%),
      var(--sky-wash);
  }

  /* Research slides alternate leaf/sky so no two adjacent slides share a wash */
  #virtual-embryo,
  #geometricflux {
    background:
      radial-gradient(46rem 26rem at -10% 100%, rgba(64, 160, 43, 0.08), transparent 60%),
      var(--leaf-wash);
  }

  #cdgrn,
  #federated-learning {
    background:
      radial-gradient(46rem 26rem at 110% 0%, rgba(116, 192, 252, 0.12), transparent 60%),
      var(--sky-wash);
  }

  /* Lesson slides carry their own designed background images; the one
     still waiting for art gets a flat sky wash. */
  #smart-healthcare-big-data {
    background: var(--sky-wash);
  }

  #join {
    /* The footer lives inside this slide, anchored to its bottom edge */
    padding-bottom: 0;
  }
</style>
