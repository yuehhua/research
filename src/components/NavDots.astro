---
/**
 * NavDots — vertical slide indicator (desktop) / thin progress rail (mobile).
 * Active state is driven by the deck script in Home.astro.
 */
import { ui, slideOrder } from '../data/content';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];
const base = (import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL).replace(/\/$/, '');
const labels: Record<string, { zh: string; en: string }> = {
  hero: { zh: '封面', en: 'Cover' },
  ...ui.nav,
};
---

<nav class="dots no-print" aria-label={lang === 'zh' ? '投影片導覽' : 'Slide navigation'}>
  {
    slideOrder.map((id) => (
      <a href={`${base}/#${id}`} data-dot={id} aria-label={t(labels[id])}>
        <span class="dot" aria-hidden="true" />
        <span class="tip">{t(labels[id])}</span>
      </a>
    ))
  }
</nav>

<style>
  .dots {
    position: fixed;
    right: calc(var(--gutter) * 0.45);
    top: 50%;
    translate: 0 -50%;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .dots a {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0.2rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hairline-color);
    transition: background 0.2s var(--ease-out), scale 0.2s var(--ease-out);
  }

  .dots a:hover .dot,
  .dots a[aria-current='true'] .dot {
    background: var(--sky);
    scale: 1.45;
  }

  .tip {
    position: absolute;
    right: calc(100% + 0.6rem);
    top: 50%;
    translate: 0 -50%;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--sky-deep);
    color: var(--paper);
    padding: 0.3em 0.7em;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s var(--ease-out);
  }

  .dots a:hover .tip,
  .dots a[aria-current='true'] .tip {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 767px) {
    .dots {
      position: fixed;
      inset: auto 0 var(--gutter) 0;
      top: auto;
      translate: none;
      flex-direction: row;
      justify-content: center;
      gap: 0.55rem;
    }

    .tip {
      display: none;
    }
  }
</style>
