---
/**
 * PageCounter — fixed "03 / 07" slide indicator with scroll hint on the cover.
 */
import { ui } from '../data/content';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];
---

<div class="counter no-print" aria-hidden="true">
  <span class="counter__num" data-counter>01 / 07</span>
  <span class="counter__hint" data-hint>{t(ui.counterHint)}</span>
</div>

<style>
  .counter {
    position: fixed;
    left: var(--gutter);
    bottom: 1.25rem;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .counter__num {
    color: var(--sky-deep);
  }

  .counter__hint {
    color: var(--gray-2);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .counter__hint.is-visible {
    opacity: 1;
    animation: nudge 2.2s var(--ease-out) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 3px;
    }
  }
</style>
