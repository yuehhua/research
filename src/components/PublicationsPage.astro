---
/**
 * PublicationsPage — the complete publication list (moved off the deck).
 * Normal scrolling page; rows mirror the deck's former publications slide.
 */
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from './Header.astro';
import { profile, publications, ui, type Lang } from '../data/content';
import { themeUi } from '../data/research';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];
const base = (import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL).replace(/\/$/, '');
const here = lang === 'zh' ? `${base}/publications/` : `${base}/en/publications/`;
const otherLangUrl = lang === 'zh' ? `${base}/en/publications/` : `${base}/publications/`;

const pageTitle =
  lang === 'zh'
    ? `論文 · ISB Lab 智慧系統生物實驗室`
    : `Publications · ISB Lab — Intelligent Systems Biology Lab`;
const byYear = new Map<number, typeof publications>();
for (const pub of publications) {
  byYear.set(pub.year, [...(byYear.get(pub.year) ?? []), pub]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'} class="no-snap">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t(themeUi.pubIntro)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t(themeUi.pubIntro)} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={here} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh'} href={otherLangUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230B57A4'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='800' font-size='14' fill='%23fff' text-anchor='middle'%3EI%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="pubs-body">
    <Header lang={lang} toggleHref={otherLangUrl} activeNav="publications" />

    <header class="pubs-hero">
      <div class="pubs-wrap">
        <a class="crumb no-print" href={`${base}/#research`}>← {t(ui.nav.research)}</a>
        <p class="slide__eyebrow"><span class="num">{lang === 'zh' ? '論文' : 'PUBS'}</span><span aria-hidden="true">—</span><span class="label-text">{t(themeUi.pubHeading)}</span></p>
        <h1 class="slide__title">{t(themeUi.pubHeading)}</h1>
        <p class="pubs-intro muted">{t(themeUi.pubIntro)}</p>
      </div>
    </header>

    <main class="pubs-wrap">
      {
        years.map((year) => (
          <section class="pub-year-group">
            <h2 class="year-heading">{year}</h2>
            <ol class="pubs list-unstyled mb-0">
              {byYear.get(year)!.map((pub) => (
                <li class="pub">
                  <div class="pub-main">
                    <p class="pub-title mb-1">{pub.title}</p>
                    <p class="pub-authors muted small mb-1">{pub.authors}</p>
                    <p class="pub-venue small fst-italic mb-0">{pub.venue}</p>
                  </div>
                  <a class="pub-link" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" aria-label={`${t(themeUi.viewPaper)}: ${pub.title}`}>
                    ↗
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </main>

    <footer class="pubs-footer">
      <div class="pubs-wrap footer-row">
        <a href={`${base}/#research`}>← {t(themeUi.sectionTitle)}</a>
        <a href={`${base}/#about`}>{t(themeUi.meetLab)} ↗</a>
        <p class="footer-id mb-0">
          <strong>{profile.labShort}</strong> · {t(profile.affiliation)}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .pubs-wrap {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .pubs-hero {
    padding: calc(3.5rem + var(--section-pad)) 0 var(--section-pad);
    background:
      radial-gradient(46rem 26rem at 110% 0%, rgba(116, 192, 252, 0.12), transparent 60%),
      var(--sky-wash);
  }

  .crumb {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gray-1);
    margin-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .crumb:hover {
    color: var(--sky);
    text-decoration: underline;
  }

  .pubs-intro {
    max-width: 52ch;
  }

  .pub-year-group {
    padding-block: clamp(1.25rem, 3vh, 2rem);
  }

  .year-heading {
    font-size: var(--text-subtitle);
    font-weight: 800;
    color: var(--sky-deep);
    margin-bottom: 0.5rem;
  }

  .pub {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    border-top: var(--hairline-soft);
    padding: 0.75em 0;
    align-items: start;
  }

  .pub:first-child {
    border-top: none;
  }

  .pub-title {
    font-weight: 700;
    line-height: 1.35;
    max-width: 68ch;
    color: var(--sky-deep);
  }

  .pub-link {
    font-size: 1.1rem;
    text-decoration: none;
    padding: 0.2em;
  }

  .pub-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pub {
      grid-template-columns: 1fr auto;
    }
  }

  /* ---------- Footer band ---------- */
  .pubs-footer {
    margin-top: clamp(2rem, 6vh, 4rem);
    padding-block: 1.1rem;
    background: var(--sky-deep);
    color: #d9ebfc;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
    font-size: var(--text-small);
  }

  .pubs-footer a {
    color: var(--paper);
    text-decoration-color: rgba(255, 255, 255, 0.4);
    font-weight: 600;
  }

  .pubs-footer a:hover {
    text-decoration-color: var(--paper);
  }

  .pubs-footer .footer-id {
    margin-left: auto;
  }

  .pubs-footer .footer-id strong {
    color: var(--paper);
  }

  @media (max-width: 767px) {
    .pubs-footer .footer-id {
      margin-left: 0;
    }
  }
</style>
