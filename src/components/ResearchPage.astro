---
/**
 * ResearchPage — full document for a featured research theme's detail page
 * (linked from the deck's 主題研究 slide). Normal scrolling page (no snap).
 * Visual: a framed figure (logo / paper figure), not a background wash.
 * Related publications resolve against content.ts by DOI.
 */
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from './Header.astro';
import { profile, publications, type Lang } from '../data/content';
import { themeUi, type ResearchTheme } from '../data/research';

interface Props {
  theme: ResearchTheme;
  lang: Lang;
  /** Representative visual (imported via astro:assets in the page wrapper). */
  visual: ImageMetadata;
  alt: string;
  credit?: string;
}

const { theme, lang, visual, alt, credit } = Astro.props;
const t = (x: { zh: string; en: string }) => x[lang];
const base = (import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL).replace(/\/$/, '');
const here = lang === 'zh' ? `${base}/${theme.slug}/` : `${base}/en/${theme.slug}/`;
const otherLangUrl = lang === 'zh' ? `${base}/en/${theme.slug}/` : `${base}/${theme.slug}/`;
const relatedPubs = publications.filter((p) => theme.pubDois.includes(p.doi));

const pageTitle =
  lang === 'zh'
    ? `${t(theme.name)} · ISB Lab 智慧系統生物實驗室`
    : `${t(theme.name)} · ISB Lab — Intelligent Systems Biology Lab`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'} class="no-snap">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t(theme.short)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t(theme.short)} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}${visual.src}`} />
    <link rel="canonical" href={here} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh'} href={otherLangUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230B57A4'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='800' font-size='14' fill='%23fff' text-anchor='middle'%3EI%3C/text%3E%3C/svg%3E"
    />
  </head>

  <body class="research-body" data-accent={theme.accent}>
    <Header lang={lang} toggleHref={otherLangUrl} />

    {/* ---------- Hero ---------- */}
    <header class="theme-hero">
      <div class="theme-wrap hero-content">
        <a class="crumb no-print" href={`${base}/#research`}>← {t(themeUi.sectionTitle)}</a>
        <p class="label hero-eyebrow">{t(themeUi.sectionTitle)}</p>
        <h1 class="slide__title theme-title">{t(theme.name)}</h1>
        <p class="theme-status">{t(theme.status)}</p>
        <ul class="theme-tags d-flex flex-wrap gap-2 ps-0 mb-0">
          {theme.tags.map((tag) => <li>{t(tag)}</li>)}
        </ul>
      </div>
    </header>

    <main class="theme-wrap">
      <div class="row g-4 g-lg-5 theme-main">
        {/* ---------- Visual figure ---------- */}
        <figure class="theme-figure col-12 col-lg-5">
          <div class="figure-frame">
            <Image src={visual} alt={alt} widths={[360, 540, 760]} sizes="(max-width: 991px) 92vw, 480px" loading="eager" class="figure-img" />
          </div>
          {credit && <figcaption class="figure-credit muted small mt-2">{credit}</figcaption>}
        </figure>

        {/* ---------- Description + metrics + links ---------- */}
        <div class="col-12 col-lg-7">
          <p class="theme-desc">{t(theme.desc)}</p>
          {theme.metrics.length > 0 && (
            <div class="theme-metrics d-flex flex-wrap gap-4 gap-lg-5 border-top pt-3 mt-4">
              {
                theme.metrics.map((m) => (
                  <div class="metric">
                    <span class="value">{m.value}</span>
                    <span class="key">{t(m.label)}</span>
                  </div>
                ))
              }
            </div>
          )}
          {theme.links.length > 0 && (
            <p class="theme-links d-flex flex-wrap gap-2 small fw-bold mt-4 mb-0">
              {theme.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
              ))}
            </p>
          )}
        </div>
      </div>

      {/* ---------- Related publications ---------- */}
      {relatedPubs.length > 0 && (
        <section class="related-pubs">
          <p class="slide__eyebrow"><span class="num">{lang === 'zh' ? '論文' : 'PUBS'}</span><span aria-hidden="true">—</span><span class="label-text">{t(themeUi.relatedPubs)}</span></p>
          <ol class="pubs list-unstyled mb-0">
            {
              relatedPubs.map((pub) => (
                <li class="pub">
                  <span class="pub-year">{pub.year}</span>
                  <div class="pub-main">
                    <p class="pub-title mb-1">{pub.title}</p>
                    <p class="pub-authors muted small mb-1">{pub.authors}</p>
                    <p class="pub-venue small fst-italic mb-0">{pub.venue}</p>
                  </div>
                  <a class="pub-link" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" aria-label={`${t(themeUi.viewPaper)}: ${pub.title}`}>↗</a>
                </li>
              ))
            }
          </ol>
        </section>
      )}
    </main>

    {/* ---------- Slim closing band ---------- */}
    <footer class="theme-footer">
      <div class="theme-wrap footer-row">
        <a href={`${base}/#research`}>← {t(themeUi.backToResearch)}</a>
        <a href={lang === 'zh' ? `${base}/publications/` : `${base}/en/publications/`}>{t(themeUi.allPubs)} ↗</a>
        <a href={`${base}/#about`}>{t(themeUi.meetLab)} ↗</a>
        <p class="footer-id mb-0">
          <strong>{profile.labShort}</strong> · {t(profile.affiliation)}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .research-body {
    --accent: var(--sky);
    --accent-heading: var(--sky-deep);
    --accent-wash: var(--sky-wash);
  }

  .research-body[data-accent='leaf'] {
    --accent: var(--leaf);
    --accent-heading: var(--leaf-deep);
    --accent-wash: var(--leaf-wash);
  }

  .theme-wrap {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---------- Hero ---------- */
  .theme-hero {
    padding: calc(3.5rem + var(--section-pad)) 0 var(--section-pad);
    background: radial-gradient(46rem 26rem at 110% 0%, rgba(116, 192, 252, 0.12), transparent 60%), var(--accent-wash);
  }

  .crumb {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gray-1);
    margin-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .crumb:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .hero-eyebrow {
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  .theme-title {
    color: var(--accent-heading);
    max-width: 18ch;
    margin-bottom: 0.6rem;
  }

  .theme-status {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--gray-1);
    margin-bottom: 1.1rem;
  }

  .theme-tags {
    list-style: none;
  }

  .theme-tags li {
    border: 1px solid var(--accent);
    color: var(--accent-heading);
    background: var(--paper);
    padding: 0.4em 0.85em;
    font-size: var(--text-small);
    font-weight: 600;
  }

  /* ---------- Main ---------- */
  .theme-main {
    padding-block: clamp(2.5rem, 6vh, 4.5rem) clamp(1.5rem, 4vh, 3rem);
    align-items: start;
  }

  .theme-figure {
    min-width: 0;
  }

  .figure-frame {
    background: var(--paper);
    border: var(--hairline);
    padding: clamp(1rem, 2.5vw, 2rem);
    display: grid;
    place-items: center;
  }

  .figure-img {
    max-height: 22rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .figure-credit {
    text-align: right;
  }

  .theme-desc {
    font-size: var(--text-subtitle);
    font-weight: 500;
    line-height: 1.6;
    max-width: 56ch;
  }

  /* ---------- Related publications (rows mirror the deck's pub list) ---------- */
  .pub {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 0.25rem 1.5rem;
    border-top: var(--hairline-soft);
    padding: 0.75em 0;
    align-items: start;
  }

  .pub:first-child {
    border-top: none;
  }

  .pub-year {
    font-weight: 800;
    color: var(--accent-heading);
    font-variant-numeric: tabular-nums;
  }

  .pub-title {
    font-weight: 700;
    line-height: 1.35;
    max-width: 60ch;
    color: var(--accent-heading);
  }

  .pub-link {
    font-size: 1.1rem;
    text-decoration: none;
    padding: 0.2em;
  }

  .pub-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pub {
      grid-template-columns: 1fr auto;
    }

    .pub-year {
      grid-column: 1 / -1;
      font-size: var(--text-small);
    }
  }

  /* ---------- Footer band ---------- */
  .theme-footer {
    margin-top: clamp(2rem, 6vh, 4rem);
    padding-block: 1.1rem;
    background: var(--sky-deep);
    color: #d9ebfc;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
    font-size: var(--text-small);
  }

  .theme-footer a {
    color: var(--paper);
    text-decoration-color: rgba(255, 255, 255, 0.4);
    font-weight: 600;
  }

  .theme-footer a:hover {
    text-decoration-color: var(--paper);
  }

  .theme-footer .footer-id {
    margin-left: auto;
  }

  .theme-footer .footer-id strong {
    color: var(--paper);
  }

  @media (max-width: 767px) {
    .theme-footer .footer-id {
      margin-left: 0;
    }
  }
</style>
