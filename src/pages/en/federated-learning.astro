---
import ResearchPage from '../../components/ResearchPage.astro';
import { researchThemes, visuals, themeImages } from '../../data/research';

const theme = researchThemes.find((t) => t.slug === 'federated-learning')!;
---
<ResearchPage theme={theme} lang="en" visual={themeImages['federated-learning']} alt={visuals['federated-learning'].alt.en} credit={visuals['federated-learning'].credit?.en} />
