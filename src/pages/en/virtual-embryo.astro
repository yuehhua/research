---
import ResearchPage from '../../components/ResearchPage.astro';
import { researchThemes, visuals, themeImages } from '../../data/research';

const theme = researchThemes.find((t) => t.slug === 'virtual-embryo')!;
---
<ResearchPage theme={theme} lang="en" visual={themeImages['virtual-embryo']} alt={visuals['virtual-embryo'].alt.en} credit={visuals['virtual-embryo'].credit?.en} />
